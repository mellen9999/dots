# local build of the patched dwl fork (bar/movestack/pertag/warpcursor)
# rebuild: cd ~/sync/config/pkg/dwl-mellen && makepkg -sif --cleanbuild
pkgname=dwl-mellen
pkgver=0.9.r5.ge422797
pkgrel=1
pkgdesc='dwl with personal patches and config'
arch=(x86_64)
url='https://github.com/mellen9999/dwl'
license=(GPL-3.0-only)
depends=(wlroots0.20 fcft libinput libxkbcommon wayland pixman libxcb xcb-util-wm)
makedepends=(git wayland-protocols pkgconf tllist)
provides=(dwl)
conflicts=(dwl dwl-git)
source=("dwl::git+file://$HOME/code/external/dwl#branch=main")
sha256sums=(SKIP)
options=(!debug)

pkgver() {
  git -C dwl describe --tags | sed 's/^v//; s/-\([0-9]*\)-g/.r\1.g/'
}

# read live, not via source=(): makepkg never re-copies a file source that already
# exists in $startdir, so config edits silently built the old config
prepare() {
  cp "$HOME/sync/config/dwl-config.h" dwl/config.h
}

build() {
  make -C dwl PREFIX=/usr
}

package() {
  make -C dwl PREFIX=/usr DESTDIR="$pkgdir" install
}
