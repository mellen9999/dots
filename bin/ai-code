#!/bin/bash
# AI Code Helper - for programming tasks
MODEL="${AI_MODEL:-qwen2.5-coder:7b}"

if [[ $# -eq 0 ]]; then
    echo "Usage: ai-code <file> [prompt]"
    echo "       cat code.py | ai-code - 'explain this'"
    exit 0
fi

FILE="$1"
shift
PROMPT="${*:-explain this code}"

if [[ "$FILE" == "-" ]]; then
    CODE=$(cat)
else
    CODE=$(cat "$FILE")
fi

ollama run "$MODEL" "Here is code:

\`\`\`
$CODE
\`\`\`

$PROMPT"
