#!/bin/bash
# AI Agent - runs commands with AI assistance
# Uses local LLM to suggest and execute commands

MODEL="${AI_MODEL:-qwen2.5-coder:7b}"

echo "AI Agent (using $MODEL)"
echo "Describe what you want to do, and I'll suggest commands."
echo "Type 'exit' to quit, 'run' to execute last suggestion."
echo ""

LAST_CMD=""

while true; do
    read -p "Task> " task
    [[ "$task" == "exit" ]] && break
    
    if [[ "$task" == "run" && -n "$LAST_CMD" ]]; then
        read -p "execute: $LAST_CMD  [y/N] " ok
        [[ "$ok" == "y" ]] && bash -c "$LAST_CMD"
        continue
    fi
    
    SYSTEM="You are a Linux command assistant. Given a task, output ONLY the bash command(s) to accomplish it. No explanations, just the command. If multiple commands, separate with &&."
    
    LAST_CMD=$(ollama run "$MODEL" --system "$SYSTEM" "$task" 2>/dev/null | head -5)
    echo "Suggested: $LAST_CMD"
    echo "(type 'run' to execute, or describe another task)"
done
