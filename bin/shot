#!/bin/bash
# screenshot -> ~/shots/shot-<time>.png and clipboard
# usage: shot [full]   (default: pick a region)  — dwl: Mod+s / Mod+Shift+s
set -euo pipefail

dir=$HOME/shots
mkdir -p "$dir"
f=$dir/shot-$(date +%Y%m%d-%H%M%S).png

if [[ ${1:-} == full ]]; then
  grim "$f"
else
  geo=$(slurp) || exit 0 # esc = cancelled, not an error
  grim -g "$geo" "$f"
fi

wl-copy --type image/png < "$f"
notify-send -t 2000 "shot saved" "${f/#$HOME/\~}"
