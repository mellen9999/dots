// Git internals — must never sync (causes ref/HEAD chaos across machines)
// (the .gitignore *file* still syncs since this only matches the .git dir)
.git

// Claude runtime data — machine-local, high-churn, no sync value
claude/.credentials.json
claude/.claude.json*
claude/history.jsonl
claude/history.sync-conflict-*
claude/debug
claude/telemetry
claude/session-env
claude/paste-cache
claude/tasks
claude/plans
claude/todos
claude/shell-snapshots
claude/stats-cache.json
claude/statsig
claude/file-history
claude/cache
claude/sessions
claude/security_warnings_state_*
claude/backups

// Claude transcripts are machine-local — only the memory/ subdirs cross machines
!claude/projects/*/memory
!claude/projects/*/memory/**
claude/projects/*/*

// claude runtime/app-managed — no sync value (2026-11-09)
claude/plugins
claude/skills/synced
claude/skills/.trash
claude/teams
claude/jobs
claude/daemon
claude/daemon.*
claude/state
claude/chrome
claude/session-log*
claude/.last-cleanup
claude/*sync-conflict*
claude/selfcheck/.stamp
claude-local/*
!claude-local/settings.json
!claude-local/.gitignore
claude/security

// per-machine build output and host-local overrides
pkg/*/src
pkg/*/pkg
pkg/*/dwl
pkg/*/*.pkg.tar.zst

// per-machine (git tracks it, syncthing never moves it)
config/chromium-flags.conf
